---
import Icon from "@/components/Icon.astro";
import Badge from "@/components/ui/badge/Badge.astro";
import Card from "@/components/ui/card/Card.astro";
import CardAction from "@/components/ui/card/CardAction.astro";
import CardContent from "@/components/ui/card/CardContent.astro";
import CardDescription from "@/components/ui/card/CardDescription.astro";
import CardHeader from "@/components/ui/card/CardHeader.astro";
import CardTitle from "@/components/ui/card/CardTitle.astro";
import type { RunCheckDoc, RunDoc } from "@/lib/convex";
import { formatDateTime, formatDuration, timeAgo } from "@/lib/format";

interface Props {
  runs: RunDoc[];
  checksByRun: Map<string, RunCheckDoc[]>;
  passRate: number;
}

const { runs, checksByRun, passRate } = Astro.props as Props;
---

<section aria-labelledby="run-history-heading">
  <Card class="gap-0 py-0">
    <CardHeader class="border-b px-5 py-5 md:px-6">
      <div>
        <CardTitle>
          <h2 id="run-history-heading">Run history</h2>
        </CardTitle>
        <CardDescription class="mt-1">
          Expand a run to inspect every check. Showing the newest runs first.
        </CardDescription>
      </div>
      <CardAction>
        <div class="rounded-lg bg-muted/60 px-3 py-2 text-right">
          <div class="text-base font-semibold tabular-nums">{passRate}%</div>
          <div class="text-[0.7rem] text-muted-foreground">
            all-time pass rate
          </div>
        </div>
      </CardAction>
    </CardHeader>

    <CardContent class="px-0 py-0">
      {
        runs.length > 0 ? (
          runs.map((run, index) => {
            const runIsRunning = run.status === "running";
            const runFailed =
              run.status === "failed" ||
              (!runIsRunning && run.passed < run.checks);
            const runPassRate =
              run.checks === 0
                ? 0
                : Math.round((run.passed / run.checks) * 100);
            const runDurationMs = runIsRunning
              ? Math.max(run.durationMs, Date.now() - run.startedAt)
              : run.durationMs;
            const checks = checksByRun.get(run.runId) ?? [];
            const orderedChecks = [...checks].sort((a, b) => {
              if (a.status === b.status) return 0;
              return a.status === "failed" ? -1 : 1;
            });
            const runBadgeVariant =
              runIsRunning || run.checks === 0
                ? "outline"
                : runFailed
                  ? "destructive"
                  : "secondary";
            const runBadgeClass = runIsRunning
              ? "border-sky-500/30 bg-sky-500/10 text-sky-600 dark:text-sky-400"
              : !runFailed && run.checks > 0
                ? "border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
                : undefined;
            const runStatusLabel = runIsRunning
              ? "Running"
              : runFailed
                ? "Failed"
                : run.checks === 0
                  ? "No checks"
                  : "Passed";

            return (
              <details
                class="group border-b last:border-b-0"
                open={index === 0}
              >
                <summary class="cursor-pointer list-none px-5 py-4 transition-colors hover:bg-muted/40 focus-visible:bg-muted/40 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring [&::-webkit-details-marker]:hidden md:px-6">
                  <div class="flex min-w-0 items-center gap-3">
                    <span
                      class:list={[
                        "flex size-9 shrink-0 items-center justify-center rounded-lg",
                        runIsRunning
                          ? "bg-sky-500/10 text-sky-600 dark:text-sky-400"
                          : run.checks === 0
                            ? "bg-amber-500/10 text-amber-600 dark:text-amber-400"
                            : runFailed
                              ? "bg-destructive/10 text-destructive"
                              : "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
                      ]}
                    >
                      {runIsRunning ? (
                        <Icon
                          name="loader-circle"
                          class="size-4 animate-spin"
                          aria-hidden="true"
                        />
                      ) : run.checks === 0 ? (
                        <Icon
                          name="triangle-alert"
                          class="size-4"
                          aria-hidden="true"
                        />
                      ) : runFailed ? (
                        <Icon
                          name="circle-x"
                          class="size-4"
                          aria-hidden="true"
                        />
                      ) : (
                        <Icon
                          name="check-circle"
                          class="size-4"
                          aria-hidden="true"
                        />
                      )}
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="flex min-w-0 flex-wrap items-center gap-2">
                        <span class="truncate text-sm font-medium">
                          Run {run.runId.slice(0, 8)}
                        </span>
                        {index === 0 && <Badge variant="outline">Latest</Badge>}
                        <Badge variant={runBadgeVariant} class={runBadgeClass}>
                          {runIsRunning && (
                            <Icon
                              name="loader-circle"
                              class="animate-spin"
                              aria-hidden="true"
                            />
                          )}
                          {runStatusLabel}
                        </Badge>
                      </span>
                      <span class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground">
                        <span title={formatDateTime(run.startedAt)}>
                          {timeAgo(run.startedAt)}
                        </span>
                        <span aria-hidden="true">·</span>
                        <span>{run.modes.join(" · ")}</span>
                        <span aria-hidden="true">·</span>
                        <span class="truncate">{run.sheetName}</span>
                        {run.commitHash && (
                          <>
                            <span aria-hidden="true">·</span>
                            <code class="font-mono text-[0.7rem]">
                              {run.commitHash.slice(0, 7)}
                            </code>
                          </>
                        )}
                      </span>
                    </span>

                    <div class="hidden w-28 shrink-0 flex-col gap-1.5 lg:flex">
                      <div
                        class="flex h-1.5 gap-0.5 overflow-hidden rounded-full bg-muted"
                        aria-label={
                          runIsRunning
                            ? `${run.passed} of ${run.checks} checks completed so far`
                            : `${run.passed} of ${run.checks} checks passed`
                        }
                      >
                        <span
                          class="rounded-full bg-emerald-500"
                          style={`width: ${runPassRate}%`}
                        />
                        <span
                          class="rounded-full bg-destructive"
                          style={`width: ${100 - runPassRate}%`}
                        />
                      </div>
                      <span class="text-right text-[0.7rem] text-muted-foreground">
                        {runIsRunning
                          ? `${run.passed}/${run.checks} completed`
                          : `${runPassRate}% passed`}
                      </span>
                    </div>

                    <div class="shrink-0 text-right">
                      <div class="text-sm font-semibold tabular-nums">
                        {run.passed}/{run.checks}
                      </div>
                      <div class="text-[0.7rem] text-muted-foreground">
                        {runIsRunning ? "checks so far" : "checks"}
                      </div>
                    </div>
                    <div class="hidden shrink-0 text-right md:block">
                      <div class="text-sm font-medium tabular-nums">
                        {formatDuration(runDurationMs)}
                      </div>
                      <div class="text-[0.7rem] text-muted-foreground">
                        duration
                      </div>
                    </div>
                    <Icon
                      name="chevron-right"
                      class="size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-90"
                      aria-hidden="true"
                    />
                  </div>
                </summary>

                <div class="border-t bg-muted/20 px-5 py-4 md:px-6">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class="text-xs font-medium tracking-wide text-muted-foreground uppercase">
                      Checks in this run
                    </span>
                    <span class="text-xs text-muted-foreground">
                      {run.passed} passed · {run.checks - run.passed} failed ·{" "}
                      {runIsRunning
                        ? "Running now"
                        : formatDateTime(run.finishedAt ?? run.startedAt)}
                    </span>
                  </div>
                  {orderedChecks.length > 0 ? (
                    <ul class="mt-3 grid gap-2 md:grid-cols-2">
                      {orderedChecks.map((check) => (
                        <li>
                          <a
                            href={`/tests/${check._id}`}
                            class="group flex min-w-0 items-center gap-3 rounded-lg border bg-card px-3 py-2.5 transition-colors hover:bg-muted/60"
                          >
                            {check.status === "passed" ? (
                              <Icon
                                name="check-circle"
                                class="size-4 shrink-0 text-emerald-500"
                                aria-hidden="true"
                              />
                            ) : (
                              <Icon
                                name="circle-x"
                                class="size-4 shrink-0 text-destructive"
                                aria-hidden="true"
                              />
                            )}
                            <span class="min-w-0 flex-1">
                              <span class="block truncate text-sm font-medium">
                                {check.testTitle}
                              </span>
                              <span class="mt-0.5 block truncate text-xs text-muted-foreground">
                                {check.clientId} · {timeAgo(check.startedAt)}
                              </span>
                            </span>
                            <span class="flex shrink-0 items-center gap-2">
                              <span class="hidden text-xs text-muted-foreground sm:inline">
                                {formatDuration(check.durationMs)}
                              </span>
                              <Badge variant="outline">{check.mode}</Badge>
                              <Icon
                                name="chevron-right"
                                class="size-4 text-muted-foreground transition-transform group-hover:translate-x-0.5"
                                aria-hidden="true"
                              />
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <div class="mt-3 rounded-lg border border-dashed bg-card px-4 py-4 text-sm text-muted-foreground">
                      {runIsRunning
                        ? "Waiting for the first test result."
                        : "No individual check details were saved for this run."}
                    </div>
                  )}
                </div>
              </details>
            );
          })
        ) : (
          <div class="px-5 py-8 text-sm text-muted-foreground md:px-6">
            No run summaries are available yet.
          </div>
        )
      }
    </CardContent>
  </Card>
</section>
