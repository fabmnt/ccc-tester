---
import Layout from "@/layouts/DashboardLayout.astro";
import Icon from "@/components/Icon.astro";
import Button from "@/components/ui/button/Button.astro";
import Card from "@/components/ui/card/Card.astro";
import CardContent from "@/components/ui/card/CardContent.astro";
import CardHeader from "@/components/ui/card/CardHeader.astro";
import Skeleton from "@/components/ui/skeleton/Skeleton.astro";
import TestResultsContent from "@/components/test-results-content.astro";
import { getActiveRun } from "@/lib/convex";
import { CONVEX_URL } from "astro:env/server";

const initialActiveRun = await getActiveRun();
const initialActiveRunIsRunning = initialActiveRun?.status === "running";
---

<Layout title="Test results">
  <div
    class="flex flex-col gap-8"
    data-convex-url={CONVEX_URL}
    data-tests-live-state
    data-active-run-id={initialActiveRunIsRunning ? initialActiveRun.runId : ""}
    data-active-run-updated-at={initialActiveRunIsRunning
      ? (initialActiveRun.updatedAt ?? initialActiveRun.startedAt)
      : ""}
    data-active-run-checks={initialActiveRunIsRunning
      ? initialActiveRun.checks
      : ""}
    data-active-run-passed={initialActiveRunIsRunning
      ? initialActiveRun.passed
      : ""}
    data-active-run-duration={initialActiveRunIsRunning
      ? initialActiveRun.durationMs
      : ""}
  >
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="flex min-w-0 flex-col gap-1.5">
        <div class="flex flex-wrap items-center gap-2.5">
          <h1 class="text-2xl font-semibold tracking-tight">Test results</h1>
        </div>
      </div>
      <div class="flex shrink-0 flex-wrap items-center gap-2">
        <Button as="a" href="/tests" variant="ghost" size="sm">
          <Icon name="rotate-cw" data-icon="inline-start" />
          Refresh
        </Button>
        <Button as="a" href="/run" size="sm">
          <Icon name="play" data-icon="inline-start" />
          Run tests
        </Button>
      </div>
    </div>

    <TestResultsContent server:defer>
      <div
        slot="fallback"
        class="flex flex-col gap-8"
        aria-busy="true"
        aria-live="polite"
      >
        <p class="sr-only">Loading test results...</p>
        <section aria-hidden="true">
          <Card class="gap-0 py-0">
            <CardHeader class="border-b px-5 py-5 md:px-6 md:py-6">
              <div
                class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between"
              >
                <div class="flex min-w-0 items-start gap-3.5">
                  <div class="min-w-0">
                    <div class="inline-flex items-center gap-x-2">
                      <Skeleton class="size-11 shrink-0 rounded-xl" />
                      <Skeleton class="h-8 w-64 max-w-full rounded" />
                    </div>
                    <Skeleton class="mt-1 h-4 w-80 max-w-full rounded" />
                  </div>
                </div>
                <div
                  class="flex shrink-0 flex-col gap-2 rounded-xl bg-background/70 px-4 py-3"
                >
                  <Skeleton class="ml-auto h-9 w-16 rounded" />
                  <Skeleton class="ml-auto h-3 w-16 rounded" />
                </div>
              </div>
            </CardHeader>
            <CardContent class="px-5 py-5 md:px-6">
              <div class="grid gap-2 md:grid-cols-2">
                {
                  Array.from({ length: 4 }).map(() => (
                    <Skeleton class="h-14 rounded-lg border bg-background/50" />
                  ))
                }
              </div>
              <Skeleton class="mt-5 h-3 w-56 max-w-full rounded" />
            </CardContent>
          </Card>
        </section>

        <Card aria-hidden="true" class="gap-0 py-0">
          <CardHeader class="border-b px-5 py-5 md:px-6">
            <div>
              <Skeleton class="h-5 w-32 rounded" />
              <Skeleton class="mt-1 h-4 w-72 max-w-full rounded" />
            </div>
            <div
              class="col-start-2 row-span-2 row-start-1 self-start justify-self-end rounded-lg bg-muted/60 px-3 py-2"
            >
              <Skeleton class="ml-auto h-5 w-10 rounded" />
              <Skeleton class="ml-auto mt-1 h-3 w-16 rounded" />
            </div>
          </CardHeader>
          <CardContent class="px-0 py-0">
            {
              Array.from({ length: 3 }).map(() => (
                <div class="flex items-center gap-3 border-b px-5 py-4 last:border-b-0 md:px-6">
                  <Skeleton class="size-9 shrink-0 rounded-lg" />
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <Skeleton class="h-4 w-40 max-w-full rounded" />
                      <Skeleton class="h-5 w-14 rounded-full" />
                    </div>
                    <Skeleton class="mt-1 h-3 w-56 max-w-full rounded" />
                  </div>
                  <div class="hidden w-28 shrink-0 flex-col gap-1.5 lg:flex">
                    <Skeleton class="h-1.5 w-full rounded-full" />
                    <Skeleton class="ml-auto h-3 w-16 rounded" />
                  </div>
                  <div class="shrink-0">
                    <Skeleton class="h-4 w-12 rounded" />
                    <Skeleton class="ml-auto mt-1 h-3 w-10 rounded" />
                  </div>
                  <div class="hidden shrink-0 md:block">
                    <Skeleton class="h-4 w-16 rounded" />
                    <Skeleton class="ml-auto mt-1 h-3 w-12 rounded" />
                  </div>
                  <Skeleton class="size-4 shrink-0 rounded" />
                </div>
              ))
            }
          </CardContent>
        </Card>
      </div>
    </TestResultsContent>
  </div>
</Layout>

<script>
  import { ConvexClient } from "convex/browser";
  import { api } from "../../../convex/_generated/api.js";

  const liveState = document.querySelector<HTMLElement>(
    "[data-tests-live-state]",
  );
  const convexUrl = liveState?.dataset.convexUrl;
  const initialSnapshot = liveState?.dataset.activeRunId
    ? [
        liveState.dataset.activeRunId,
        "running",
        liveState.dataset.activeRunChecks ?? "",
        liveState.dataset.activeRunPassed ?? "",
        liveState.dataset.activeRunDuration ?? "",
        liveState.dataset.activeRunUpdatedAt ?? "",
      ].join(":")
    : "";
  let lastSnapshot = initialSnapshot;

  const getActiveRunSnapshot = (run: unknown): string => {
    if (typeof run !== "object" || run === null) {
      return "";
    }

    const activeRun = run as {
      runId?: unknown;
      status?: unknown;
      startedAt?: unknown;
      updatedAt?: unknown;
      checks?: unknown;
      passed?: unknown;
      durationMs?: unknown;
    };
    if (activeRun.status !== "running" || typeof activeRun.runId !== "string") {
      return "";
    }

    const updatedAt =
      typeof activeRun.updatedAt === "number"
        ? activeRun.updatedAt
        : activeRun.startedAt;
    return [
      activeRun.runId,
      activeRun.status,
      activeRun.checks,
      activeRun.passed,
      activeRun.durationMs,
      typeof updatedAt === "number" ? updatedAt : "",
    ].join(":");
  };

  if (convexUrl) {
    const convex = new ConvexClient(convexUrl);
    const activeRunSubscription = convex.onUpdate(
      api.runChecks.getActive,
      {},
      (run) => {
        const snapshot = getActiveRunSnapshot(run);
        if (snapshot === lastSnapshot) {
          return;
        }

        lastSnapshot = snapshot;
        window.location.reload();
      },
      (error) => {
        console.error("Live test run updates failed:", error);
      },
    );

    window.addEventListener(
      "pagehide",
      () => {
        activeRunSubscription.unsubscribe();
        void convex.close();
      },
      { once: true },
    );
  } else {
    console.error("Live test run updates are unavailable: missing Convex URL.");
  }
</script>
