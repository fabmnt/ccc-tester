---
import Icon from "@/components/Icon.astro";
import Alert from "@/components/ui/alert/Alert.astro";
import AlertDescription from "@/components/ui/alert/AlertDescription.astro";
import AlertTitle from "@/components/ui/alert/AlertTitle.astro";
import Badge from "@/components/ui/badge/Badge.astro";
import Button from "@/components/ui/button/Button.astro";
import Card from "@/components/ui/card/Card.astro";
import CardContent from "@/components/ui/card/CardContent.astro";
import CardHeader from "@/components/ui/card/CardHeader.astro";
import CardTitle from "@/components/ui/card/CardTitle.astro";
import Layout from "@/layouts/DashboardLayout.astro";
import { getTestResult } from "@/lib/convex";
import { formatDateTime, formatDuration } from "@/lib/format";

const id = Astro.params.id ?? "";
const result = await getTestResult(id);

const facts = result
  ? [
      { label: "Mode", value: result.mode },
      { label: "Client", value: result.clientId },
      { label: "Clinic", value: result.clinicId },
      { label: "Scope", value: result.scope },
      { label: "Started", value: formatDateTime(result.startedAt) },
      { label: "Duration", value: formatDuration(result.durationMs) },
      { label: "Run ID", value: result.runId },
      { label: "Sheet", value: result.sheetName },
      { label: "Commit", value: result.commitHash ?? "—" },
      { label: "Route", value: result.route ?? "—" },
    ]
  : [];

const artifacts = result
  ? [
      { label: "Trace", path: result.tracePath, icon: "file-archive" },
      { label: "Screenshot", path: result.screenshotPath, icon: "file-image" },
      { label: "Video", path: result.videoPath, icon: "video" },
    ].filter((artifact) => artifact.path !== undefined)
  : [];
---

<Layout title={result ? result.testTitle : "Test result"}>
  {
    result === null ? (
      <Card>
        <CardContent class="flex flex-col items-start gap-2">
          <p class="text-sm text-muted-foreground">Test result not found.</p>
          <Button as="a" href="/tests" variant="outline">
            Back to test results
          </Button>
        </CardContent>
      </Card>
    ) : (
      <div class="flex flex-col gap-4">
        <a
          href="/tests"
          class="inline-flex w-fit items-center gap-1 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          <Icon name="chevron-left" class="size-4" />
          Back to results
        </a>

        <div class="flex flex-col gap-2">
          <div class="flex flex-wrap items-center gap-2.5">
            <Badge
              variant={result.status === "passed" ? "secondary" : "destructive"}
              class={
                result.status === "passed"
                  ? "border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
                  : undefined
              }
            >
              {result.status}
            </Badge>
            <h1 class="text-xl font-semibold tracking-tight">
              {result.testTitle}
            </h1>
          </div>
          <p class="text-sm text-muted-foreground">
            {result.mode} · {result.clientId} · started{" "}
            {formatDateTime(result.startedAt)} · took{" "}
            {formatDuration(result.durationMs)}
          </p>
        </div>

        {result.errorMessage && (
          <Alert variant="destructive">
            <Icon name="circle-alert" />
            <AlertTitle>Test failed</AlertTitle>
            <AlertDescription>{result.errorMessage}</AlertDescription>
          </Alert>
        )}

        <Card>
          <CardHeader>
            <CardTitle>Run details</CardTitle>
          </CardHeader>
          <CardContent>
            <dl class="grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
              {facts.map((fact) => (
                <div>
                  <dt class="text-sm text-muted-foreground">{fact.label}</dt>
                  <dd class="break-words text-sm font-medium">{fact.value}</dd>
                </div>
              ))}
            </dl>
          </CardContent>
        </Card>

        {artifacts.length > 0 && (
          <Card>
            <CardHeader>
              <CardTitle>Artifacts</CardTitle>
            </CardHeader>
            <CardContent>
              <ul class="flex flex-col gap-2">
                {artifacts.map(({ label, path, icon }) => (
                  <li class="flex items-center gap-2 rounded-lg border px-3 py-2">
                    <Icon
                      name={icon}
                      class="size-4 shrink-0 text-muted-foreground"
                    />
                    <span class="w-22 shrink-0 text-sm text-muted-foreground">
                      {label}
                    </span>
                    <code class="min-w-0 flex-1 truncate rounded bg-muted px-1.5 py-0.5 font-mono text-xs">
                      {path}
                    </code>
                  </li>
                ))}
              </ul>
            </CardContent>
          </Card>
        )}
      </div>
    )
  }
</Layout>
