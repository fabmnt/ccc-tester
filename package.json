{
  "name": "ccc-tester",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "build:cli": "tsc --project tsconfig.cli.json",
    "ccc-tester": "node ./dist-cli/bin/ccc-tester.js",
    "test:e2e": "node ./dist-cli/bin/ccc-tester.js",
    "test:e2e:dev": "node ./dist-cli/bin/ccc-tester.js --mode=dev",
    "test:e2e:production": "node ./dist-cli/bin/ccc-tester.js --mode=production",
    "test:frontend:e2e": "node ./dist-cli/bin/ccc-tester.js --mode=frontend",
    "typecheck": "astro check",
    "lint": "eslint . --ext .astro,.ts,.js,.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@data-slot/tabs": "^0.2.166",
    "@fontsource-variable/geist": "^5.3.0",
    "@lucide/astro": "^1.37.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "bejamas": "^0.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "shadcn": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
