{
  "name": "ccc-tester",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "build:cli": "tsc --project tsconfig.cli.json",
    "ccc-tester": "node ./dist-cli/bin/ccc-tester.js",
    "test:e2e": "node ./dist-cli/bin/ccc-tester.js",
    "test:e2e:dev": "node ./dist-cli/bin/ccc-tester.js --mode=dev",
    "test:e2e:production": "node ./dist-cli/bin/ccc-tester.js --mode=production",
    "test:frontend:e2e": "node ./dist-cli/bin/ccc-tester.js --mode=frontend",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .astro,.js,.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "astro": "^7.2.9",
    "convex": "^1.45.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.2"
  }
}
